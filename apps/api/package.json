{
  "name": "@rinde/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST de Rinde. Ejecuta el mismo motor que la PWA.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput & node --watch dist/server.js",
    "start": "node dist/server.js",
    "seed": "tsc -b && node dist/seed.js"
  },
  "dependencies": {
    "@rinde/core": "*",
    "@rinde/data": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
