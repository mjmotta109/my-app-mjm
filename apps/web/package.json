{
  "name": "@rinde/web",
  "version": "0.1.0",
  "private": true,
  "description": "Rinde — PWA mobile-first.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "e2e": "node e2e/smoke.mjs",
    "build:native": "RINDE_TARGET=native vite build && cap sync android",
    "icons": "node scripts/gen-icons.mjs",
    "android:open": "cap open android",
    "android:apk": "RINDE_TARGET=native vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:bundle": "RINDE_TARGET=native vite build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@rinde/core": "*",
    "@rinde/data": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
